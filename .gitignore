node_modules/
.wrangler/
.dev.vars
dist/

# The tendency model. 22 MB of JSON that packs to 1.9 MB gzipped; it is
# bundled or served, never committed raw. The vault lost five days of backup
# to a 903 MB blob in main on 2026-09-05.
tendency.json
*.tendency.json

# Competitor captures and anything pulled from a CDN.
captures/

# Whole seasons pulled by tools/capture-season.mjs - about 6,000 games, hundreds
# of MB even gzipped. Re-runnable from the feed, so never committed; a game a
# test needs is captured whole into fixtures/ with capture-fixture.mjs instead.
data/

dist/

# The captured feed payloads ARE evidence and are committed. A directory
# exclusion cannot be undone by a negation, which is what the first attempt at
# this rule got wrong - and it silently dropped them from the commit rather than
# failing loudly, which is the worse half.

.push-token.local

.poll-done-*
poll.log
.poll.log
.poll.err

# personal Claude Code permissions (the 5 AM nuggets run) - never committed
.claude/settings.local.json
